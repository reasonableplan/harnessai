#!/usr/bin/env python3
"""HarnessAI — ha-run 외부 루프 (Ralph-style fresh-context driver, 옵트인).

파이프라인 상태는 전부 harness-plan.md / tasks.md 에 있다 (ha-run 의 "상태 캐싱
금지") — 그래서 각 스텝을 `claude -p "/<skill> <args>"` **새 세션**으로 실행해도
진행이 유실되지 않는다. 긴 자율 런의 컨텍스트 부패·30루프 상한·캐시 비용을 해소.
짧은 런은 세션 내 /ha-run (warm cache) 이 더 싸다 — 이 래퍼는 긴 런 전용 옵트인.

동작:
  1. `~/.claude/skills/ha-run/run.py next` 로 다음 행동 판독 (결정론 드라이버)
  2. mode=auto  → `claude -p "/<skill> <args>"` fresh 세션 실행
     mode=hitl  → exit 2 정지 (인터뷰/배포확인은 headless 처리 불가 — 인터랙티브 /ha-run 안내)
     action=done → exit 0
  3. 게이트 BLOCK (하위 exit != 0) → 우회 플래그 자동 부여 없이 즉시 정지 (ha-run 가드레일 동일)
  4. 무전이 3연속 / max-loops 초과 → 정지 (상태는 파일에 있으므로 재실행으로 이어짐)

사용:
  python ~/.claude/harness/bin/ha-loop --project . [--dry-run] [--max-loops 50]
  권한 기본값: --permission-mode acceptEdits --allowedTools Bash,Agent
  (환경에 따라 --claude-args 로 조정. --bare 금지 — 스킬 자동발견이 꺼진다.)
"""
from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
from pathlib import Path

HOME_SKILLS = Path.home() / ".claude" / "skills"


def _force_utf8_stdio() -> None:
    """LESSON-033: 한국어 Windows cp949 콘솔에서 상태 이모지 출력 크래시 방지."""
    for stream in (sys.stdout, sys.stderr):
        if stream.encoding and stream.encoding.lower() not in ("utf-8", "utf8"):
            stream.reconfigure(encoding="utf-8", errors="replace")


def read_next(project: Path) -> dict:
    """ha-run run.py next 호출 — 다음 행동 JSON (action/mode/skill/args/current_step)."""
    run_py = HOME_SKILLS / "ha-run" / "run.py"
    if not run_py.exists():
        raise RuntimeError(f"ha-run 미설치: {run_py}")
    proc = subprocess.run(
        [sys.executable, str(run_py), "next"],
        cwd=project,
        capture_output=True,
        text=True,
        encoding="utf-8",
    )
    if proc.returncode != 0:
        raise RuntimeError(f"ha-run next 실패 (exit {proc.returncode}): {proc.stderr.strip()}")
    return json.loads(proc.stdout)


def invoke_claude(prompt: str, project: Path, claude_args: list[str], dry_run: bool) -> int:
    """스텝 1개를 fresh claude 세션으로 실행. dry-run 은 명령만 출력."""
    cmd = ["claude", "-p", prompt, *claude_args]
    print(f"  $ {' '.join(cmd)}", flush=True)
    if dry_run:
        return 0
    proc = subprocess.run(cmd, cwd=project)
    return proc.returncode


def run_loop(project: Path, max_loops: int, claude_args: list[str], dry_run: bool = False) -> int:
    stall_key: tuple[str | None, str | None] | None = None
    stall_count = 0
    for i in range(1, max_loops + 1):
        nxt = read_next(project)
        action = nxt.get("action")
        step = nxt.get("current_step")

        if action == "done":
            print(f"✅ 파이프라인 완료 (shipped) — 실행 스텝 {i - 1}개")
            return 0

        key = (action, step)
        stall_count = stall_count + 1 if key == stall_key else 1
        stall_key = key
        if stall_count >= 3:
            print(
                f"⛔ 무전이 3연속 ({action} @ {step}) — 게이트/상태 수동 확인 필요",
                file=sys.stderr,
            )
            return 1

        if nxt.get("mode") != "auto":
            print(
                f"⏸ HITL 지점: {action} @ {step} — {nxt.get('reason', '')}\n"
                "  인터뷰/확인은 headless 로 처리 불가. 인터랙티브 세션에서 /ha-run 으로 계속하세요."
            )
            return 2

        skill = nxt["skill"]
        args_s = (nxt.get("args") or "").strip()
        prompt = f"/{skill} {args_s}".strip()
        print(f"▶ [{step}] {prompt} (fresh 세션 {i}/{max_loops})")
        rc = invoke_claude(prompt, project, claude_args, dry_run)
        if dry_run:
            print("(dry-run) 첫 auto 스텝 미리보기만 출력 — 실제 실행 없음")
            return 0
        if rc != 0:
            print(
                f"⛔ {prompt} 실패 (exit {rc}) — 게이트 BLOCK 가능성. "
                "우회 플래그를 자동으로 붙이지 않습니다. 수동 확인 후 재실행하세요.",
                file=sys.stderr,
            )
            return 1

    print(
        f"⛔ max-loops {max_loops} 초과 — 상태는 harness-plan.md 에 있으므로 재실행으로 이어집니다.",
        file=sys.stderr,
    )
    return 1


def main() -> int:
    _force_utf8_stdio()
    parser = argparse.ArgumentParser(
        prog="ha-loop", description="ha-run 외부 루프 — 스텝마다 fresh claude -p 세션 (옵트인)"
    )
    parser.add_argument("--project", default=".", help="프로젝트 루트 (기본: cwd)")
    parser.add_argument("--max-loops", type=int, default=50, help="세션 실행 상한 (기본 50)")
    parser.add_argument(
        "--claude-args",
        default="--permission-mode acceptEdits --allowedTools Bash,Agent",
        help="claude -p 에 전달할 플래그 (공백 분리 문자열). --bare 금지",
    )
    parser.add_argument("--dry-run", action="store_true", help="첫 auto 스텝 명령만 출력")
    args = parser.parse_args()

    project = Path(args.project).resolve()
    if not (project / "docs" / "harness-plan.md").exists():
        print(f"[FAIL] harness-plan.md 없음: {project}/docs — /ha-init 선행 필요", file=sys.stderr)
        return 1

    claude_args = shlex.split(args.claude_args)
    if "--bare" in claude_args:
        print("[FAIL] --bare 는 스킬 자동발견을 꺼서 /ha-* 호출이 깨집니다 — 제거하세요", file=sys.stderr)
        return 1

    try:
        return run_loop(project, args.max_loops, claude_args, dry_run=args.dry_run)
    except (RuntimeError, json.JSONDecodeError) as e:
        print(f"[FAIL] {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
