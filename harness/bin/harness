#!/usr/bin/env python3
"""harness — HarnessAI v2 스키마 검증 CLI

사용법:
  python harness validate                  # 전체 검증 (registry + profiles + fragments)
  python harness validate profiles         # 프로파일만
  python harness validate fragments        # 스켈레톤 조각만
  python harness validate <path>           # 단일 파일
  python harness validate --plan <path>    # harness-plan.md 검증

  python harness migrate-skeleton-hash <plan-path>         # dry-run: 계산할 hash 미리 보기
  python harness migrate-skeleton-hash <plan-path> --apply # legacy plan 에 hash 백필 + 자동 백업

종료 코드:
  0: 전부 통과 / dry-run 정보 출력
  1: 검증 실패 (하나 이상) / apply 중 I/O 오류
  2: 사용 오류 (잘못된 인자)
  3: 내부 오류 (파일 없음 등)
"""
from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

# UTF-8 stdout/stderr 강제 (Windows cp949 호환성)
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
except (AttributeError, OSError):
    pass  # Python < 3.7 또는 non-TTY 환경

try:
    import yaml
except ImportError:
    print("[FATAL] PyYAML required. Install: pip install pyyaml", file=sys.stderr)
    sys.exit(3)


import hashlib
import json
import os
from datetime import datetime, timezone

# ── 상수 ───────────────────────────────────────────────────────────────

# Resolve harness root with this priority:
#   1. HARNESS_ROOT env var (explicit override)
#   2. Script location: harness/bin/harness → parents[1] == harness/ root
#      — matches both repo layout (<repo>/harness/) and install target
#      (~/.claude/harness/) without depending on $HOME.
#   3. Fallback: ~/.claude/harness (legacy default)
_SCRIPT_ROOT = Path(__file__).resolve().parents[1]
HARNESS_ROOT = Path(
    os.environ.get("HARNESS_ROOT")
    or (_SCRIPT_ROOT if (_SCRIPT_ROOT / "profiles" / "_registry.yaml").exists() else Path.home() / ".claude" / "harness")
)

STANDARD_SECTION_IDS = {
    # 기본 20 (v0.4 까지)
    "overview", "requirements", "stack", "configuration", "errors",
    "auth", "persistence", "integrations",
    "interface.http", "interface.cli", "interface.ipc", "interface.sdk",
    "view.screens", "view.components", "state.flow", "core.logic",
    "observability", "deployment", "tasks", "notes",
    # required_when 6축 표현식으로 자동 활성 (10)
    "data_model", "threat_model", "audit_log", "slo", "runbook",
    "test_strategy", "user_journey", "authorization_matrix", "ci_cd", "external_deps",
    # 모바일 (3)
    "mobile.navigation", "mobile.build_config", "mobile.lifecycle",
    # 웹/환경 (3, v0.7.0) — context.SECTION_TITLES 와 동기 유지
    "environments", "error_ux", "rate_limiting",
}

ALLOWED_GSTACK_MODES = {"auto", "manual", "prompt"}
ALLOWED_PROFILE_STATUS = {"confirmed", "draft"}

# required_when 표준 vocabulary (design doc §4.6 + 모바일 확장 §4.4)
REQUIRED_WHEN_ATOMS = {
    "always",
    "has.users", "has.storage", "has.env_config", "has.external_deps",
    "has.http_server", "has.cli_entrypoint", "has.ipc", "has.ui",
    "has.complex_state", "has.sdk_surface", "has.production_concerns",
    # Mobile — mobile.* 섹션 선언 시 활성. _SECTION_TO_HAS_KEY 와 동기.
    "has.navigation", "has.build_config", "has.lifecycle",
    "scale.small_or_larger", "scale.medium_or_larger", "scale.large",
}

# 6-axis names — KEEP IN SYNC with backend ScaleAxes fields.
# backend/src/orchestrator/plan_manager.py 의 ScaleAxes 필드와 동기.
# drift 발생 시 backend pytest test_six_axis_names_all_recognized 실패.
_AXIS_NAMES_CLI = frozenset({
    "user_scale", "data_sensitivity", "team_size",
    "availability", "monetization", "lifecycle",
})

# 6-axis 표현식 sanity patterns (Phase 2-b)
# 실제 evaluate 는 backend/scale_expression.py 가 담당. 이 validator 는 syntax 만.
_AXIS_COMPARE_RE = re.compile(r"^([a-z_][a-z0-9_]*)\s*==\s*([a-z_][a-z0-9_]*)$")
_AXIS_MEMBERSHIP_RE = re.compile(
    r"^([a-z_][a-z0-9_]*)\s+in\s+\[\s*([a-z_][a-z0-9_]*(?:\s*,\s*[a-z_][a-z0-9_]*)*)\s*\]$"
)

# detect 블록 허용 연산자
# files: 모두 존재 (AND). files_any: 하나라도 존재 (OR — Android Gradle 등 디스점션 케이스).
DETECT_OPERATORS = {"files", "files_any", "contains", "contains_any", "not_contains"}

FRONTMATTER_RE = re.compile(r"^---\r?\n(.*?)\r?\n---", re.DOTALL)


# ── 결과 ───────────────────────────────────────────────────────────────

@dataclass
class Issue:
    severity: str  # "error" | "warn"
    file: str
    message: str


@dataclass
class Report:
    issues: list[Issue] = field(default_factory=list)
    files_checked: int = 0

    @property
    def error_count(self) -> int:
        return sum(1 for i in self.issues if i.severity == "error")

    @property
    def warn_count(self) -> int:
        return sum(1 for i in self.issues if i.severity == "warn")

    def error(self, file: str, msg: str) -> None:
        self.issues.append(Issue("error", file, msg))

    def warn(self, file: str, msg: str) -> None:
        self.issues.append(Issue("warn", file, msg))

    def merge(self, other: Report) -> None:
        self.issues.extend(other.issues)
        self.files_checked += other.files_checked


# ── 파싱 ───────────────────────────────────────────────────────────────

def parse_frontmatter(path: Path) -> dict[str, Any] | None:
    """Markdown 파일에서 YAML frontmatter 추출. 없으면 None."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise RuntimeError(f"{path} 읽기 실패: {exc}") from exc

    m = FRONTMATTER_RE.match(text)
    if not m:
        return None

    try:
        data = yaml.safe_load(m.group(1))
    except yaml.YAMLError as exc:
        raise ValueError(f"{path} YAML 파싱 실패: {exc}") from exc

    return data if isinstance(data, dict) else None


# ── 검증: 프로파일 ─────────────────────────────────────────────────────

_PROFILE_REQUIRED = {
    "id": str,
    "name": str,
    "status": str,
    "version": int,
    "components": list,
    "skeleton_sections": dict,
    "toolchain": dict,
    "whitelist": dict,
    "file_structure": str,
    "gstack_mode": str,
}


def validate_profile(path: Path, report: Report) -> None:
    report.files_checked += 1
    name = path.name

    try:
        data = parse_frontmatter(path)
    except (RuntimeError, ValueError) as exc:
        report.error(name, str(exc))
        return

    if data is None:
        report.error(name, "YAML frontmatter 없음")
        return

    # 필수 필드 + 타입
    for key, expected_type in _PROFILE_REQUIRED.items():
        if key not in data:
            report.error(name, f"필수 필드 누락: {key}")
            continue
        if not isinstance(data[key], expected_type):
            report.error(name, f"{key}: {expected_type.__name__} 필요, {type(data[key]).__name__} 발견")

    # _base 제외 — _base는 다른 스키마
    if data.get("id") == "_base":
        return

    # id가 파일명과 일치
    stem = path.stem
    if data.get("id") != stem:
        report.error(name, f"id='{data.get('id')}' 가 파일명 stem '{stem}' 와 불일치")

    # status
    if data.get("status") not in ALLOWED_PROFILE_STATUS:
        report.error(name, f"status: {ALLOWED_PROFILE_STATUS} 중 하나여야 함, 현재 '{data.get('status')}'")

    # gstack_mode
    if data.get("gstack_mode") not in ALLOWED_GSTACK_MODES:
        report.error(name, f"gstack_mode: {ALLOWED_GSTACK_MODES} 중 하나여야 함, 현재 '{data.get('gstack_mode')}'")

    # skeleton_sections 스키마
    sections = data.get("skeleton_sections", {})
    if isinstance(sections, dict):
        for sub in ("required", "optional", "order"):
            if sub not in sections:
                report.error(name, f"skeleton_sections.{sub} 누락")
            elif not isinstance(sections[sub], list):
                report.error(name, f"skeleton_sections.{sub}: list 필요")

        # 섹션 ID 유효성 (표준 또는 dotted 도메인 허용)
        for sub in ("required", "optional", "order"):
            for sid in sections.get(sub, []) or []:
                if sid not in STANDARD_SECTION_IDS and "." not in sid:
                    report.warn(name, f"비표준 섹션 ID: '{sid}' (dotted 도메인 ID 권장)")

        # order는 required ∪ optional 의 부분집합
        required_set = set(sections.get("required", []) or [])
        optional_set = set(sections.get("optional", []) or [])
        declared = required_set | optional_set
        for sid in sections.get("order", []) or []:
            if sid not in declared:
                report.error(name, f"order의 '{sid}' 가 required/optional 에 선언 안 됨")

    # components 스키마 + skeleton_section 참조 무결성
    components = data.get("components", [])
    declared_sections: set[str] = set()
    sections_frontmatter = data.get("skeleton_sections", {})
    if isinstance(sections_frontmatter, dict):
        declared_sections = set(sections_frontmatter.get("required", []) or []) | set(sections_frontmatter.get("optional", []) or [])

    if isinstance(components, list):
        for i, comp in enumerate(components):
            if not isinstance(comp, dict):
                report.error(name, f"components[{i}]: dict 필요")
                continue
            for req_key in ("id", "required", "skeleton_section"):
                if req_key not in comp:
                    report.error(name, f"components[{i}].{req_key} 누락")
            sec = comp.get("skeleton_section")
            if sec:
                if sec not in STANDARD_SECTION_IDS and "." not in sec:
                    report.warn(name, f"components[{i}].skeleton_section='{sec}' 비표준")
                # 참조 무결성 — components가 참조하는 섹션이 skeleton_sections에 선언되어야 함
                if declared_sections and sec not in declared_sections:
                    report.error(name, f"components[{i}].skeleton_section='{sec}' 가 skeleton_sections.required/optional 에 선언 안 됨")

    # detect 블록 스키마
    detect = data.get("detect")
    if detect is not None:
        if not isinstance(detect, dict):
            report.error(name, "detect: dict 여야 함")
        else:
            if "paths" in data.get("detect", {}):
                report.warn(name, "detect.paths 는 frontmatter 최상위 'paths' 에 위치 (detect 내부 X)")
            for op, val in detect.items():
                if op == "paths":
                    continue
                if op not in DETECT_OPERATORS:
                    report.error(name, f"detect.{op}: 알 수 없는 연산자 (허용: {sorted(DETECT_OPERATORS)})")
                    continue
                if op in ("files", "files_any"):
                    if not isinstance(val, list):
                        report.error(name, f"detect.{op}: list 필요")
                elif op in ("contains", "contains_any", "not_contains"):
                    if not isinstance(val, dict):
                        report.error(name, f"detect.{op}: dict (file → substrings) 필요")
                    else:
                        for fname, subs in val.items():
                            if not isinstance(subs, list):
                                report.error(name, f"detect.{op}.{fname}: list 필요")

    # toolchain 스키마
    toolchain = data.get("toolchain", {})
    if isinstance(toolchain, dict):
        for req_key in ("install", "test", "lint"):
            if req_key not in toolchain:
                report.error(name, f"toolchain.{req_key} 누락 (null 허용)")

    # whitelist 스키마
    whitelist = data.get("whitelist", {})
    if isinstance(whitelist, dict):
        for req_key in ("runtime", "dev"):
            if req_key not in whitelist:
                report.error(name, f"whitelist.{req_key} 누락")
            elif not isinstance(whitelist[req_key], list):
                report.error(name, f"whitelist.{req_key}: list 필요")


def validate_base_md(path: Path, report: Report) -> None:
    """_base.md는 프로파일과 다른 스키마. 존재 확인만."""
    report.files_checked += 1
    try:
        data = parse_frontmatter(path)
    except (RuntimeError, ValueError) as exc:
        report.error(path.name, str(exc))
        return
    if data is None:
        report.error(path.name, "YAML frontmatter 없음")
        return
    if data.get("id") != "_base":
        report.error(path.name, f"_base.md의 id는 '_base' 여야 함, 현재 '{data.get('id')}'")


# ── 검증: 순환 상속 ────────────────────────────────────────────────────

def detect_inheritance_cycles(profiles_dir: Path, report: Report) -> None:
    """extends 체인에서 순환 탐지 + 존재하지 않는 부모 참조 탐지."""
    extends_map: dict[str, str | None] = {}
    known_ids: set[str] = {"_base"}  # _base는 암묵적 최상위

    for f in profiles_dir.glob("*.md"):
        if f.name == "_base.md":  # _base는 최상위 — extends 검증 대상 아님
            continue
        try:
            data = parse_frontmatter(f)
        except (RuntimeError, ValueError):
            continue
        if not data:
            continue
        pid = data.get("id")
        if isinstance(pid, str):
            extends_map[pid] = data.get("extends")
            known_ids.add(pid)

    for start, parent in extends_map.items():
        # 존재하지 않는 부모 참조 탐지
        if parent is not None and parent not in known_ids:
            report.error(f"{start}.md", f"extends 참조 '{parent}' — 해당 프로파일 파일 없음")
            continue

        # 순환 탐지
        visited = set()
        cur: str | None = start
        while cur is not None:
            if cur in visited:
                report.error(f"{start}.md", f"순환 상속 탐지: {' -> '.join([*visited, cur])}")
                break
            visited.add(cur)
            nxt = extends_map.get(cur)
            if nxt == "_base" or nxt is None:
                break
            cur = nxt


# ── 검증: 섹션 조각 ────────────────────────────────────────────────────

_FRAGMENT_REQUIRED = {
    "id": str,
    "name": str,
    "required_when": str,
    "description": str,
}


def validate_fragment(path: Path, report: Report) -> None:
    report.files_checked += 1
    name = path.name

    try:
        data = parse_frontmatter(path)
    except (RuntimeError, ValueError) as exc:
        report.error(name, str(exc))
        return

    if data is None:
        report.error(name, "YAML frontmatter 없음")
        return

    for key, expected_type in _FRAGMENT_REQUIRED.items():
        if key not in data:
            report.error(name, f"필수 필드 누락: {key}")
            continue
        if not isinstance(data[key], expected_type):
            report.error(name, f"{key}: {expected_type.__name__} 필요")

    stem = path.stem
    if data.get("id") != stem:
        report.error(name, f"id='{data.get('id')}' 가 파일명 stem '{stem}' 와 불일치")

    # required_when vocabulary 검증
    rw = data.get("required_when")
    if isinstance(rw, str):
        err = _validate_required_when_expression(rw)
        if err:
            report.error(name, f"required_when='{rw}' — {err}")

    # 본문에 {{section_number}} 플레이스홀더 있는지 확인
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        report.error(name, f"파일 읽기 실패: {exc}")
        return
    body = FRONTMATTER_RE.sub("", text, count=1).strip()
    if "{{section_number}}" not in body:
        report.warn(name, "본문에 {{section_number}} 플레이스홀더 없음")


def _validate_required_when_expression(rw: str) -> str | None:
    """required_when 표현식 syntax 검증. 통과 시 None, 실패 시 에러 메시지.

    허용 형태:
      - 표준 atom: always / has.* / scale.*
      - 6축 비교: <axis> == <value>
      - 6축 멤버십: <axis> in [<v1>, <v2>, ...]
      - 위 셋의 or/and/+/괄호 결합

    의도적으로 syntax 만 검증 — 실제 평가는 ProfileLoader (Phase 2-b-3) 가 담당.
    precedence 검증은 안 함 (사용자 작성 표현식이 단순하다는 가정 + backend
    scale_expression.py 의 정식 파서가 더 엄격하게 검증).
    """
    expr = rw.strip()
    if not expr:
        return "빈 표현식"
    # 괄호 표현식 reject — CLI validator 는 단순 정규식 splitter 라 (a or b) and c
    # 같은 precedence override 를 정확히 분석할 수 없음. "통과했는데 실제론 틀린"
    # validator 가 되는 걸 방지하기 위해 명시적 거부. 정식 평가는 ProfileLoader
    # (Phase 2-b-3) 가 backend scale_expression.parse() 로 수행하며 거기서는 괄호 OK.
    if "(" in expr or ")" in expr:
        return (
            "괄호 표현식은 CLI validator 가 syntax 검증을 보장하지 않음. "
            "괄호 없이 표기 (and 가 or 보다 우선 — Python 표준) 또는 backend "
            "scale_expression.parse() 로 직접 검증."
        )
    # or / and / + 로 분리 → 각 piece 가 atom 또는 6축 표현식
    pieces = re.split(r"\s+(?:or|and)\s+|\s*\+\s*", expr)
    for piece in pieces:
        atom = piece.strip()
        if not atom:
            return "빈 atom 발견"
        if atom in REQUIRED_WHEN_ATOMS:
            continue
        m = _AXIS_COMPARE_RE.match(atom)
        if m:
            axis = m.group(1)
            if axis not in _AXIS_NAMES_CLI:
                return (
                    f"unknown axis '{axis}' in '{atom}' "
                    f"(allowed: {sorted(_AXIS_NAMES_CLI)})"
                )
            continue
        m = _AXIS_MEMBERSHIP_RE.match(atom)
        if m:
            axis = m.group(1)
            if axis not in _AXIS_NAMES_CLI:
                return (
                    f"unknown axis '{axis}' in '{atom}' "
                    f"(allowed: {sorted(_AXIS_NAMES_CLI)})"
                )
            continue
        return (
            f"'{atom}' 은 표준 vocab 외이고 6축 표현식 syntax 도 아님. "
            f"허용: {sorted(REQUIRED_WHEN_ATOMS)} 또는 '<axis> == <value>' "
            f"또는 '<axis> in [<v1>, ...]'"
        )
    return None


# ── 검증: _registry.yaml ──────────────────────────────────────────────

def validate_registry(path: Path, report: Report) -> None:
    report.files_checked += 1
    name = path.name

    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        report.error(name, f"읽기 실패: {exc}")
        return

    try:
        data = yaml.safe_load(text)
    except yaml.YAMLError as exc:
        report.error(name, f"YAML 파싱 실패: {exc}")
        return

    if not isinstance(data, dict):
        report.error(name, "최상위가 dict 여야 함")
        return

    if data.get("version") != 1:
        report.error(name, f"version: 1 필요, 현재 {data.get('version')}")

    rules = data.get("rules", [])
    if not isinstance(rules, list):
        report.error(name, "rules: list 필요")
        return

    for i, rule in enumerate(rules):
        if not isinstance(rule, dict):
            report.error(name, f"rules[{i}]: dict 필요")
            continue
        for req in ("profile", "paths", "detect"):
            if req not in rule:
                report.error(name, f"rules[{i}].{req} 누락")
        if "paths" in rule and not isinstance(rule["paths"], list):
            report.error(name, f"rules[{i}].paths: list 필요")
        if "detect" in rule and not isinstance(rule["detect"], dict):
            report.error(name, f"rules[{i}].detect: dict 필요")

    fb = data.get("fallback")
    if isinstance(fb, dict) and fb.get("action") not in ("prompt_user",):
        report.warn(name, f"fallback.action: 'prompt_user' 권장, 현재 '{fb.get('action')}'")


# ── 검증: harness-plan.md ──────────────────────────────────────────────

_PLAN_REQUIRED = {
    "harness_version": int,
    "schema_version": int,
    "project_name": str,
    "profiles": list,
    "skeleton_sections": dict,
    "pipeline": dict,
}


def validate_plan(path: Path, report: Report) -> None:
    report.files_checked += 1
    name = path.name

    try:
        data = parse_frontmatter(path)
    except (RuntimeError, ValueError) as exc:
        report.error(name, str(exc))
        return

    if data is None:
        report.error(name, "YAML frontmatter 없음")
        return

    for key, expected in _PLAN_REQUIRED.items():
        if key not in data:
            report.error(name, f"필수 필드 누락: {key}")
        elif not isinstance(data[key], expected):
            report.error(name, f"{key}: {expected.__name__} 필요")

    pipe = data.get("pipeline", {})
    if isinstance(pipe, dict):
        for req in ("steps", "current_step", "completed_steps", "gstack_mode"):
            if req not in pipe:
                report.error(name, f"pipeline.{req} 누락")
        if pipe.get("gstack_mode") not in ALLOWED_GSTACK_MODES:
            report.error(name, f"pipeline.gstack_mode: {ALLOWED_GSTACK_MODES} 중 하나여야 함")

    skel = data.get("skeleton_sections", {})
    if isinstance(skel, dict) and "included" not in skel:
        report.error(name, "skeleton_sections.included 누락")


# ── skeleton 정합성 (integrity) ───────────────────────────────────────
#
# skeleton.md 의 ```filesystem 블록에서 선언한 경로가 실제 존재하는지 + 플레이스홀더
# (<pkg>, <cmd_a> 등) 잔존 여부를 검사한다. /ha-verify 가 toolchain 실행 전에 호출.

_PLACEHOLDER_RE = re.compile(r"<[a-z_][a-z0-9_]*>")

_FILESYSTEM_BLOCK_RE = re.compile(r"^```filesystem\s*\n(.*?)\n```", re.MULTILINE | re.DOTALL)

# 표준 HTML/SVG 태그 — 플레이스홀더 오탐 방지.
# KEEP IN SYNC with backend/src/orchestrator/skeleton_assembler.py._HTML_TAGS —
# drift 감지: backend/tests/skills/test_html_tags_sync.py
_HTML_TAGS = frozenset({
    "a", "abbr", "address", "area", "article", "aside", "audio",
    "b", "base", "bdi", "bdo", "blockquote", "body", "br", "button",
    "canvas", "caption", "cite", "code", "col", "colgroup",
    "data", "datalist", "dd", "del", "details", "dfn", "dialog", "div", "dl", "dt",
    "em", "embed", "fieldset", "figcaption", "figure", "footer", "form",
    "h1", "h2", "h3", "h4", "h5", "h6", "head", "header", "hgroup", "hr", "html",
    "i", "iframe", "img", "input", "ins",
    "kbd", "label", "legend", "li", "link",
    "main", "map", "mark", "meta", "meter",
    "nav", "noscript", "object", "ol", "optgroup", "option", "output",
    "p", "param", "picture", "pre", "progress",
    "q", "rp", "rt", "ruby", "s", "samp", "script", "section", "select",
    "slot", "small", "source", "span", "strong", "style", "sub", "summary", "sup",
    "table", "tbody", "td", "template", "textarea", "tfoot", "th", "thead",
    "time", "title", "tr", "track", "u", "ul", "var", "video", "wbr",
    "svg", "path", "rect", "circle", "line", "polyline", "polygon", "g",
    "ellipse", "defs", "use", "symbol", "mask", "pattern", "clippath",
    "lineargradient", "radialgradient", "stop", "text", "tspan",
})


def _parse_filesystem_tree(block: str) -> list[str]:
    """들여쓰기 트리를 상대 경로 리스트로 평면화.

    예:
        backend/
          pyproject.toml
          src/pkg/
            cli.py

    결과: ['backend/', 'backend/pyproject.toml', 'backend/src/pkg/', 'backend/src/pkg/cli.py']
    """
    paths: list[str] = []
    stack: list[tuple[int, str]] = []  # (indent_depth, parent_prefix)
    for raw in block.splitlines():
        line = raw.rstrip()
        stripped = line.lstrip()
        if not stripped or stripped.startswith("#"):
            continue
        # 인라인 주석 제거
        if " #" in stripped:
            stripped = stripped.split(" #", 1)[0].rstrip()
        if not stripped:
            continue
        indent = len(line) - len(stripped)
        while stack and stack[-1][0] >= indent:
            stack.pop()
        prefix = stack[-1][1] if stack else ""
        full = prefix + stripped
        paths.append(full)
        if stripped.endswith("/"):
            stack.append((indent, full))
    return paths


def _find_plan_file(project: Path, override: Path | None) -> Path | None:
    if override is not None:
        return override if override.exists() else None
    candidates = [
        project / "docs" / "harness-plan.md",
        project / "backend" / "docs" / "harness-plan.md",
    ]
    return next((c for c in candidates if c.exists()), None)


def _check_placeholders(skeleton_path: Path, text: str, report: Report) -> None:
    """skeleton 본문에 치환 안 된 플레이스홀더가 있는지 확인."""
    # 백틱 코드 블록 중 ```python/```ts 등은 예제 코드일 수 있어 스킵.
    # filesystem 블록은 포함 (실제 경로여야 함).
    # 개행 보존 치환 — 라인 번호가 원본과 일치하도록.
    sanitized = re.sub(
        r"```(?!filesystem)\w*\n.*?\n```",
        lambda m: "\n" * m.group(0).count("\n"),
        text,
        flags=re.DOTALL,
    )
    found: dict[str, int] = {}
    for lineno, line in enumerate(sanitized.splitlines(), 1):
        # 인라인 백틱 코드 (`<pkg>` 같은 템플릿 예시) 제거 — 형식 표시용
        stripped = re.sub(r"`[^`\n]*`", "", line)
        for m in _PLACEHOLDER_RE.finditer(stripped):
            literal = m.group(0)
            tag_name = literal[1:-1]
            if tag_name in _HTML_TAGS:
                continue  # HTML/SVG 태그는 플레이스홀더 아님
            found.setdefault(literal, lineno)
    for placeholder, first_line in sorted(found.items()):
        report.error(
            skeleton_path.name,
            f"플레이스홀더 미치환 (line {first_line}): {placeholder} — /ha-design 에서 실제 값으로 기입",
        )


def _check_filesystem(skeleton_path: Path, text: str, project: Path, report: Report) -> None:
    """```filesystem 블록에 선언된 경로가 실재하는지 검사 (opt-in).

    블록이 없으면 silent pass — 사용자가 선언한 경우에만 검증.
    """
    m = _FILESYSTEM_BLOCK_RE.search(text)
    if not m:
        return  # opt-in: 블록 없으면 검사 안 함
    declared = _parse_filesystem_tree(m.group(1))
    if not declared:
        report.warn(skeleton_path.name, "```filesystem 블록이 비어있음")
        return

    missing: list[str] = []
    for rel in declared:
        abs_path = (project / rel).resolve()
        if not abs_path.exists():
            missing.append(rel)

    if missing:
        for rel in missing:
            report.error(
                skeleton_path.name,
                f"선언 경로 미존재: {rel}",
            )


@dataclass
class _IntegrityVerboseItem:
    """verbose 출력을 위한 검사 항목 결과."""
    label: str    # 표시할 항목 이름
    passed: bool  # True: ✓, False: FAIL/WARN
    detail: str   # 보조 설명


@dataclass
class IntegrityVerboseResult:
    """check_integrity_verbose 의 상세 결과."""
    project: Path
    plan_path: Path | None
    skeleton_path: Path | None
    skeleton_exists: bool
    filesystem_blocks: int          # ```filesystem 블록 수
    filesystem_paths_declared: int  # 선언된 경로 수
    filesystem_paths_ok: int        # 실재 확인된 경로 수
    placeholder_count: int          # 미치환 placeholder 수
    drift_checks: list[tuple[str, list[str], list[str]]]  # [(profile_id, extras, missing)]


def check_integrity(project: Path, plan_override: Path | None, report: Report) -> None:
    """skeleton.md 선언 ↔ 실재 파일시스템 정합성 검사 (플레이스홀더 + 경로 존재)."""
    check_integrity_verbose(project, plan_override, report)


def check_integrity_verbose(
    project: Path,
    plan_override: Path | None,
    report: Report,
) -> IntegrityVerboseResult | None:
    """skeleton.md 선언 ↔ 실재 파일시스템 정합성 검사 (verbose 정보 포함 반환).

    report 에 에러/경고를 기록하고, verbose 출력용 IntegrityVerboseResult 를 반환.
    오류로 조기 종료 시 None 반환.
    """
    plan_path = _find_plan_file(project, plan_override)
    if plan_path is None:
        report.error("harness-plan.md", f"파일 없음 (프로젝트: {project})")
        return None
    report.files_checked += 1  # plan.md 는 참고만 하고 실제 검증은 skeleton.md 에

    skeleton_path = plan_path.parent / "skeleton.md"
    if not skeleton_path.exists():
        report.warn("skeleton.md", "아직 생성 안 됨 (skip) — /ha-design 후 다시 실행")
        return IntegrityVerboseResult(
            project=project,
            plan_path=plan_path,
            skeleton_path=skeleton_path,
            skeleton_exists=False,
            filesystem_blocks=0,
            filesystem_paths_declared=0,
            filesystem_paths_ok=0,
            placeholder_count=0,
            drift_checks=[],
        )

    report.files_checked += 1
    try:
        text = skeleton_path.read_text(encoding="utf-8")
    except OSError as exc:
        report.error(skeleton_path.name, f"읽기 실패: {exc}")
        return None

    # placeholder 검사 — 검사 전 에러 수 기록해 증분 계산
    errors_before = report.error_count
    _check_placeholders(skeleton_path, text, report)
    placeholder_errors = report.error_count - errors_before

    # filesystem 블록 검사 — 선언/실재 경로 수 계산
    fs_match = _FILESYSTEM_BLOCK_RE.search(text)
    fs_blocks = 1 if fs_match else 0
    declared_paths: list[str] = []
    paths_ok = 0
    if fs_match:
        declared_paths = _parse_filesystem_tree(fs_match.group(1))
        for rel in declared_paths:
            if (project / rel).resolve().exists():
                paths_ok += 1
        if declared_paths:
            # 실제 에러 기록은 _check_filesystem 에 위임
            errors_before2 = report.error_count
            _check_filesystem(skeleton_path, text, project, report)
            _ = report.error_count - errors_before2  # 사용하지 않지만 명시적으로 delta 계산
        else:
            report.warn(skeleton_path.name, "```filesystem 블록이 비어있음")
    # fs_match 없으면 _check_filesystem 은 silent pass

    # file_structure drift (advisory WARN) — FP #17: plan 의 confirmed 프로파일만
    # 검사 (비활성 12종 노이즈 제거). plan 에 profiles 가 없으면 None → 전 프로파일
    # (legacy fallback). _check_file_structure_drift 단일출처에 위임.
    plan_data = _load_plan_frontmatter(plan_path) or {}
    confirmed_ids = {
        p["id"]
        for p in (plan_data.get("profiles") or [])
        if isinstance(p, dict) and "id" in p and p.get("status", "confirmed") == "confirmed"
    }
    drift_checks = _check_file_structure_drift(
        project,
        HARNESS_ROOT / "profiles",
        report,
        confirmed_ids=confirmed_ids or None,
    )

    return IntegrityVerboseResult(
        project=project,
        plan_path=plan_path,
        skeleton_path=skeleton_path,
        skeleton_exists=True,
        filesystem_blocks=fs_blocks,
        filesystem_paths_declared=len(declared_paths),
        filesystem_paths_ok=paths_ok,
        placeholder_count=placeholder_errors,
        drift_checks=drift_checks,
    )


# ── file_structure drift audit ────────────────────────────────────────
#
# profile.file_structure (frontmatter의 들여쓰기 트리) 와
# 실제 프로젝트 디렉토리를 비교해 drift 를 WARN (advisory) 으로 보고.

_SKIP_DIRS: frozenset[str] = frozenset({
    "node_modules", "__pycache__", ".git", ".next", ".expo",
    "dist", "build", ".build", "out", ".cache", ".turbo",
    ".gradle", ".idea", ".vscode", "__tests__", "tests",
    ".pytest_cache", "coverage", ".nyc_output", "target",
    "venv", ".venv", "env",
})

_INLINE_COMMENT_RE = re.compile(r"\s+#.*$")


def _has_skip_segment(rel_path: str) -> bool:
    """True if any path segment is a skip dir (build/test/vcs artefact).

    FP #17: _scan_project_dirs skips _SKIP_DIRS, so a profile declaring e.g.
    ``desktop/__tests__/`` would otherwise be reported missing even when it
    exists on disk. Excluding such declared paths removes that asymmetry.
    """
    return any(seg in _SKIP_DIRS for seg in rel_path.strip("/").split("/"))


def _parse_file_structure_tree(tree_text: str) -> set[str]:
    """들여쓰기 트리 문자열 → 디렉토리 상대 경로 set (trailing '/').

    파일 항목(자식 없는 비-'/' 항목)은 제외. 인라인 주석(# ...) 제거.
    템플릿 플레이스홀더 (<domain> 등)는 있는 그대로 보존.
    """
    lines_raw: list[tuple[int, str]] = []
    for raw_line in tree_text.splitlines():
        stripped = raw_line.rstrip()
        if not stripped:
            continue
        stripped = _INLINE_COMMENT_RE.sub("", stripped).rstrip()
        if not stripped:
            continue
        name = stripped.lstrip()
        if not name or name.startswith("#"):
            continue
        indent = len(stripped) - len(name)
        lines_raw.append((indent, name))

    if not lines_raw:
        return set()

    dirs: set[str] = set()
    stack: list[tuple[int, str]] = []  # (indent, full_path)

    for idx, (indent, name) in enumerate(lines_raw):
        while stack and stack[-1][0] >= indent:
            stack.pop()

        prefix = stack[-1][1] if stack else ""
        full = prefix + name

        is_dir = name.endswith("/")
        if not is_dir and idx + 1 < len(lines_raw):
            next_indent = lines_raw[idx + 1][0]
            if next_indent > indent:
                is_dir = True

        if is_dir:
            dir_path = full if full.endswith("/") else full + "/"
            dirs.add(dir_path)
            stack.append((indent, dir_path))
        else:
            stack.append((indent, full))

    return dirs


def _scan_project_dirs(scan_root: Path, top_n: int = 3) -> set[str]:
    """scan_root 아래 실제 디렉토리를 top_n 깊이까지 수집 (set of 'rel/path/')."""
    if not scan_root.exists() or not scan_root.is_dir():
        return set()
    result: set[str] = set()
    _collect_dirs_recursive(scan_root, scan_root, 1, top_n, result)
    return result


def _collect_dirs_recursive(
    scan_root: Path, current: Path, depth: int, top_n: int, out: set[str]
) -> None:
    if depth > top_n:
        return
    try:
        entries = list(current.iterdir())
    except PermissionError:
        return
    for entry in entries:
        if not entry.is_dir():
            continue
        if entry.name in _SKIP_DIRS or entry.name.startswith("."):
            continue
        rel = entry.relative_to(scan_root).as_posix() + "/"
        out.add(rel)
        _collect_dirs_recursive(scan_root, entry, depth + 1, top_n, out)


def _check_file_structure_drift(
    project: Path,
    profiles_dir: Path,
    report: Report,
    *,
    confirmed_ids: set[str] | None = None,
) -> list[tuple[str, list[str], list[str]]]:
    """profile file_structure 와 실제 디렉토리 비교 — drift 를 WARN + drift_checks 반환.

    profiles_dir 내 *.md (비 _base, 비 _registry) 프로파일을 순회.
    각 profile 의 file_structure 필드를 파싱해 declared 디렉토리 set 계산.
    실제 project 디렉토리 (top 3) 와 비교, extras 있으면 WARN.

    FP #17:
    - ``confirmed_ids`` 가 주어지면 해당 프로파일만 검사 (비활성 12종 노이즈 제거).
      None 이면 전 프로파일 순회 (legacy — plan 에 confirmed 프로파일 없을 때).
    - declared 에서 _SKIP_DIRS 세그먼트(__tests__/tests 등)를 제외해 scan 이
      skip 하는 디렉토리를 missing 으로 오보고하지 않음.
    """
    drift_checks: list[tuple[str, list[str], list[str]]] = []
    if not profiles_dir.exists():
        return drift_checks

    # 모든 프로파일이 같은 project 디렉토리와 비교 — 1회만 스캔.
    actual = _scan_project_dirs(project, top_n=3)

    for profile_file in sorted(profiles_dir.glob("*.md")):
        if profile_file.name in ("_base.md",):
            continue
        try:
            data = parse_frontmatter(profile_file)
        except (RuntimeError, ValueError):
            continue
        if not isinstance(data, dict):
            continue

        profile_id = data.get("id", profile_file.stem)
        if profile_id == "_base":
            continue
        if confirmed_ids is not None and profile_id not in confirmed_ids:
            continue

        file_structure = data.get("file_structure", "")
        if not isinstance(file_structure, str) or not file_structure.strip():
            continue

        declared = _parse_file_structure_tree(file_structure)
        if not declared:
            continue

        # declared 에서 placeholder(<...>) 와 skip-dir 세그먼트 제외 (FP #17).
        declared_concrete = {
            d for d in declared if "<" not in d and not _has_skip_segment(d)
        }
        extras = sorted(actual - declared_concrete)
        missing = sorted(declared_concrete - actual)
        drift_checks.append((str(profile_id), extras, missing))

        if extras:
            report.warn(
                f"profile:{profile_id}",
                f"file_structure drift: extras={extras}, missing={missing} "
                f"— 의도적 확장이면 profile.file_structure 에 추가하거나 무시",
            )

    return drift_checks


# ── migrate-skeleton-hash ──────────────────────────────────────────────
#
# legacy plan (skeleton_hash="") 에 현재 skeleton.md 의 SHA-256 hash 를 백필.
# --apply 없으면 dry-run (파일 변경 없음).


def _compute_skeleton_hash_inline(skeleton_path: Path) -> str:
    """skeleton.md SHA-256 (CRLF/LF 정규화 후). 파일 없으면 빈 문자열."""
    if not skeleton_path.exists():
        return ""
    raw = skeleton_path.read_bytes()
    normalized = raw.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
    return hashlib.sha256(normalized).hexdigest()


def _load_plan_frontmatter(plan_path: Path) -> dict[str, Any] | None:
    """harness-plan.md frontmatter 로드. 파싱 실패 시 None."""
    try:
        data = parse_frontmatter(plan_path)
    except (RuntimeError, ValueError):
        return None
    return data


# ── graph subcommand (v0.9.1) ────────────────────────────────────────────
# tasks.md → mermaid flowchart TD. backend src 의 tasks_schema.extract_task_graph
# / render_mermaid 와 동일 로직을 inline 으로 재구현 (CLI standalone 제약).
# v0.8.0 메모리에 추가됐다 기록만 됐고 실제는 미구현이었던 케이스 — v0.9.1 보충.

_GRAPH_TASK_ROW_RE = re.compile(
    r"^\|\s*(T-\d{3,})\s*\|\s*([^|]+?)\s*\|\s*([^|]*?)\s*\|\s*([^|]*?)\s*\|\s*([^|]*?)\s*\|\s*$"
)
_GRAPH_DEP_TOKEN_RE = re.compile(r"^T-\d{3,}$")
_GRAPH_SECTION_HEADER = "## 의존성 그래프 (자동 생성)"
_GRAPH_DEPS_NONE = {"", "-", "—", "–"}


def _parse_tasks_for_graph(content: str) -> list[tuple[str, tuple[str, ...], str | None]]:
    """tasks.md → [(task_id, depends_on, phase), ...]. invalid id silently skip."""
    nodes: list[tuple[str, tuple[str, ...], str | None]] = []
    current_phase: str | None = None
    for line in content.splitlines():
        stripped = line.strip()
        if stripped.startswith("##") and "Phase" in stripped:
            current_phase = stripped.lstrip("#").strip()
            continue
        m = _GRAPH_TASK_ROW_RE.match(line)
        if not m:
            continue
        task_id = m.group(1).strip()
        deps_raw = m.group(3).strip()
        if deps_raw in _GRAPH_DEPS_NONE:
            deps: tuple[str, ...] = ()
        else:
            deps = tuple(
                d.strip() for d in deps_raw.split(",")
                if d.strip() and _GRAPH_DEP_TOKEN_RE.match(d.strip())
            )
        nodes.append((task_id, deps, current_phase))
    return nodes


def _render_mermaid_inline(
    nodes: list[tuple[str, tuple[str, ...], str | None]],
    *,
    group_by_phase: bool = True,
) -> str:
    """노드 리스트 → mermaid flowchart TD 문자열 (no trailing newline)."""
    if not nodes:
        return "flowchart TD\n    %% no tasks"
    lines = ["flowchart TD"]
    if group_by_phase:
        # dict 삽입 순서 = encounter 순서 (Phase 1 → Phase 2+ → ...)
        phase_nodes: dict[str | None, list[str]] = {}
        for tid, _deps, phase in nodes:
            phase_nodes.setdefault(phase, []).append(tid)
        for phase, ids in phase_nodes.items():
            if phase is not None:
                lines.append(f'    subgraph "{phase}"')
                for tid in ids:
                    lines.append(f"        {tid}")
                lines.append("    end")
            else:
                for tid in ids:
                    lines.append(f"    {tid}")
    else:
        for tid, _deps, _phase in nodes:
            lines.append(f"    {tid}")
    for tid, deps, _phase in nodes:
        for dep in deps:
            lines.append(f"    {dep} --> {tid}")
    return "\n".join(lines)


def cmd_graph(tasks_path: Path, *, inject: bool, no_phases: bool) -> int:
    """graph 서브커맨드 — tasks.md 의존성 그래프 mermaid 출력 또는 파일 주입."""
    if not tasks_path.exists():
        print(f"[FAIL] tasks.md 없음: {tasks_path}", file=sys.stderr)
        return 1
    try:
        content = tasks_path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"[FAIL] tasks.md 읽기 실패: {exc}", file=sys.stderr)
        return 1

    nodes = _parse_tasks_for_graph(content)
    mermaid = _render_mermaid_inline(nodes, group_by_phase=not no_phases)

    if not inject:
        print(mermaid)
        return 0

    # --inject: 자동 백업 → 기존 섹션 멱등 교체 → 파일 끝에 새 섹션 append
    from datetime import datetime, timezone
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup_path = tasks_path.parent / f".backup-pre-graph-inject-{ts}.md"
    try:
        backup_path.write_text(content, encoding="utf-8")
    except OSError as exc:
        print(f"[FAIL] 백업 쓰기 실패 {backup_path}: {exc}", file=sys.stderr)
        return 1

    # 기존 섹션 (헤더부터 다음 동급 ## 헤더 또는 EOF 까지) 제거 — 멱등 보장
    section_re = re.compile(
        re.escape(_GRAPH_SECTION_HEADER) + r".*?(?=\n##\s|\Z)",
        re.DOTALL,
    )
    cleaned = section_re.sub("", content).rstrip()
    new_section = (
        f"\n\n{_GRAPH_SECTION_HEADER}\n\n"
        f"```mermaid\n{mermaid}\n```\n"
    )
    try:
        tasks_path.write_text(cleaned + new_section, encoding="utf-8")
    except OSError as exc:
        print(f"[FAIL] tasks.md 쓰기 실패: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_migrate_skeleton_hash(
    plan_path: Path,
    apply: bool,
    no_backup: bool,
) -> int:
    """migrate-skeleton-hash 서브커맨드 구현.

    Args:
        plan_path: harness-plan.md 절대 경로
        apply: True 면 파일 변경 + 자동 백업. False 면 dry-run.
        no_backup: True 면 apply 시 백업 생성 안 함.

    Returns:
        exit code (0: 성공/dry-run, 1: I/O 오류, 3: 내부 오류)
    """
    if not plan_path.exists():
        print(f"[FAIL] plan 파일 없음: {plan_path}", file=sys.stderr)
        return 3

    # plan frontmatter 로드
    data = _load_plan_frontmatter(plan_path)
    if data is None:
        print(f"[FAIL] plan frontmatter 파싱 실패: {plan_path}", file=sys.stderr)
        return 3

    existing_hash = str(data.get("skeleton_hash") or "")

    # 이미 hash 가 있으면 WARN + 종료 (덮어쓰기 방지)
    if existing_hash:
        result = {
            "plan_path": str(plan_path),
            "old_hash": existing_hash,
            "new_hash": None,
            "applied": False,
            "backup_path": None,
            "warn": "skeleton_hash 가 이미 존재합니다. 손상 방지를 위해 종료합니다. "
                    "강제 갱신이 필요하면 frontmatter 에서 skeleton_hash 를 직접 제거 후 재실행.",
        }
        print(json.dumps(result, ensure_ascii=False, indent=2))
        print(
            f"[WARN] {plan_path.name}: skeleton_hash 이미 존재 ({existing_hash[:12]}…). "
            "파일 미수정.",
            file=sys.stderr,
        )
        return 0

    # skeleton.md 탐색 (plan 과 같은 디렉토리)
    skeleton_path = plan_path.parent / "skeleton.md"
    if not skeleton_path.exists():
        print(
            f"[FAIL] skeleton.md 를 찾을 수 없습니다: {skeleton_path}\n"
            "       /ha-design 이 완료된 후 실행하세요.",
            file=sys.stderr,
        )
        return 3

    new_hash = _compute_skeleton_hash_inline(skeleton_path)

    result: dict[str, Any] = {
        "plan_path": str(plan_path),
        "skeleton_path": str(skeleton_path),
        "old_hash": "",
        "new_hash": new_hash,
        "applied": False,
        "backup_path": None,
    }

    if not apply:
        # dry-run: 정보만 출력, 파일 미수정
        print(json.dumps(result, ensure_ascii=False, indent=2))
        print(
            f"[DRY-RUN] {plan_path.name}: skeleton_hash = {new_hash[:16]}…\n"
            "           --apply 를 추가하면 plan 에 기록됩니다.",
            file=sys.stderr,
        )
        return 0

    # --apply: 백업 → plan 갱신 → 저장
    backup_path_str: str | None = None
    if not no_backup:
        ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
        backup_name = f".harness-backup-{ts}.md"
        backup_file = plan_path.parent / backup_name
        try:
            backup_file.write_text(plan_path.read_text(encoding="utf-8"), encoding="utf-8")
            backup_path_str = str(backup_file)
        except OSError as exc:
            print(f"[FAIL] 백업 생성 실패 ({backup_file}): {exc}", file=sys.stderr)
            return 1

    # plan 파일 직접 수정: frontmatter 에 skeleton_hash 삽입
    # PlanManager.save() 를 쓰면 backend import 가 필요하므로,
    # 단순 텍스트 치환으로 frontmatter 에 한 줄 추가 (안전 — YAML 마지막 필드로 append).
    try:
        plan_text = plan_path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"[FAIL] plan 읽기 실패: {exc}", file=sys.stderr)
        return 1

    m = FRONTMATTER_RE.match(plan_text)
    if not m:
        print(f"[FAIL] frontmatter 를 찾을 수 없습니다: {plan_path}", file=sys.stderr)
        return 3

    # frontmatter 내부에 skeleton_hash 행 삽입 (마지막 필드 바로 앞 --- 전)
    fm_content = m.group(1)
    rest = plan_text[m.end():]
    new_fm = fm_content.rstrip("\n") + f"\nskeleton_hash: {new_hash}\n"
    new_text = f"---\n{new_fm}\n---{rest}"

    try:
        plan_path.write_text(new_text, encoding="utf-8")
    except OSError as exc:
        print(f"[FAIL] plan 저장 실패: {exc}", file=sys.stderr)
        return 1

    result["applied"] = True
    result["backup_path"] = backup_path_str
    print(json.dumps(result, ensure_ascii=False, indent=2))
    print(
        f"[OK] skeleton_hash 백필 완료: {new_hash[:16]}…\n"
        + (f"     백업: {backup_path_str}" if backup_path_str else "     (백업 생략)"),
        file=sys.stderr,
    )
    return 0


# ── analyze-failure ──────────────────────────────────────────────────────────
#
# /ha-verify 단계 2.5 자동화: 빌드/테스트 출력에서 실패 파일 추출 + tasks.md 매핑.
# backend/src/orchestrator/failure_analyzer.py 에 핵심 로직, 이 CLI 는 분기만 담당.
# V1/R4 패턴과 동일: CLI 가 standalone 이라 backend import 불가 → inline 구현.

_FA_PYTEST_RE = re.compile(r"^FAILED\s+([^\s:]+)", re.MULTILINE)
_FA_PYRIGHT_RE = re.compile(r"^([^\s:][^\s]*\.py):\d+", re.MULTILINE)
_FA_ESLINT_RE = re.compile(r"^([^\s][^\s]*\.[jt]sx?):\d+:\d+\s+(?:error|warning)", re.MULTILINE)
_FA_JEST_FAIL_RE = re.compile(r"^FAIL\s+([^\s]+)", re.MULTILINE)
_FA_JEST_STACK_RE = re.compile(r"\(([^)\s:][^)\s]*\.[jt]sx?):\d+:\d+\)", re.MULTILINE)
_FA_TSC_RE = re.compile(r"^([^\s(][^\s(]*\.[jt]sx?)\(\d+,\d+\):\s+error", re.MULTILINE)

_FA_TASK_ROW_RE = re.compile(r"^\|\s*(T-\d+)\s*\|", re.MULTILINE)


def _fa_extract_files(output: str) -> list[str]:
    found: dict[str, None] = {}
    for pat in (_FA_PYTEST_RE, _FA_PYRIGHT_RE, _FA_ESLINT_RE, _FA_JEST_FAIL_RE, _FA_JEST_STACK_RE, _FA_TSC_RE):
        for m in pat.finditer(output):
            norm = m.group(1).replace("\\", "/").strip()
            if norm and norm not in found:
                found[norm] = None
    return list(found.keys())


def _fa_spec_blocks(tasks_text: str) -> dict[str, str]:
    positions = [(m.group(1), m.start()) for m in _FA_TASK_ROW_RE.finditer(tasks_text)]
    blocks: dict[str, str] = {}
    for i, (tid, start) in enumerate(positions):
        end = positions[i + 1][1] if i + 1 < len(positions) else len(tasks_text)
        blocks[tid] = tasks_text[start:end]
    return blocks


def _cmd_analyze_failure(args: Any) -> int:
    """analyze-failure 서브커맨드 구현."""
    import argparse as _argparse

    output_file: str = args.output_file
    tasks_arg: str = args.tasks

    # output 읽기
    if output_file == "-":
        try:
            output_text = sys.stdin.read()
        except OSError as exc:
            print(f"[FAIL] stdin 읽기 실패: {exc}", file=sys.stderr)
            return 1
    else:
        op = Path(output_file)
        if not op.exists():
            print(f"[FAIL] output 파일 없음: {op}", file=sys.stderr)
            return 1
        try:
            output_text = op.read_text(encoding="utf-8", errors="replace")
        except OSError as exc:
            print(f"[FAIL] output 파일 읽기 실패: {exc}", file=sys.stderr)
            return 1

    # tasks.md 읽기
    tp = Path(tasks_arg)
    if not tp.exists():
        print(f"[FAIL] tasks.md 없음: {tp}", file=sys.stderr)
        return 1
    try:
        tasks_text = tp.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        print(f"[FAIL] tasks.md 읽기 실패: {exc}", file=sys.stderr)
        return 1

    # 분석
    failed_files = _fa_extract_files(output_text)
    spec_blocks = _fa_spec_blocks(tasks_text)

    matches: list[dict[str, object]] = []
    matched: set[str] = set()
    for tid, block in spec_blocks.items():
        block_norm = block.replace("\\", "/")
        task_matched = [
            f for f in failed_files
            if Path(f).name in block_norm or f in block_norm
        ]
        if task_matched:
            for f in task_matched:
                matched.add(f)
            matches.append({"task_id": tid, "files": task_matched})

    result: dict[str, object] = {
        "failures": failed_files,
        "matches": matches,
        "unmatched_failures": [f for f in failed_files if f not in matched],
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


# ── 러너 ───────────────────────────────────────────────────────────────

def validate_all(report: Report) -> None:
    registry_path = HARNESS_ROOT / "profiles" / "_registry.yaml"
    if registry_path.exists():
        validate_registry(registry_path, report)
    else:
        report.error("_registry.yaml", "파일 없음")

    profiles_dir = HARNESS_ROOT / "profiles"
    if profiles_dir.exists():
        for f in sorted(profiles_dir.glob("*.md")):
            if f.name == "_base.md":
                validate_base_md(f, report)
            else:
                validate_profile(f, report)
        detect_inheritance_cycles(profiles_dir, report)
    else:
        report.error("profiles/", "디렉토리 없음")

    fragments_dir = HARNESS_ROOT / "templates" / "skeleton"
    if fragments_dir.exists():
        for f in sorted(fragments_dir.glob("*.md")):
            if f.name.startswith("_"):
                continue  # `_` prefix = fragment 아닌 메타 문서 (_README.md 등)
            validate_fragment(f, report)
    else:
        report.error("templates/skeleton/", "디렉토리 없음")


def validate_single(target: Path, report: Report) -> None:
    if not target.exists():
        report.error(target.name, "파일 없음")
        return

    # 경로 기반 분기
    name = target.name
    parent = target.parent.name

    if name == "_registry.yaml":
        validate_registry(target, report)
    elif name == "_base.md":
        validate_base_md(target, report)
    elif parent == "profiles":
        validate_profile(target, report)
    elif parent == "skeleton":
        validate_fragment(target, report)
    elif name == "harness-plan.md":
        validate_plan(target, report)
    else:
        report.error(name, f"알 수 없는 파일 위치 (parent='{parent}'). --plan 플래그를 쓰거나 올바른 위치에 두세요.")


def print_report(report: Report) -> None:
    for issue in report.issues:
        tag = "[ERROR]" if issue.severity == "error" else "[WARN] "
        print(f"{tag} [{issue.file}] {issue.message}")

    print()
    print(f"Files checked: {report.files_checked}")
    print(f"Errors: {report.error_count}")
    print(f"Warnings: {report.warn_count}")

    if report.error_count == 0:
        print("\n[OK] Schema validation passed")
    else:
        print("\n[FAIL] Validation failed - fix errors above")


def print_integrity_report(
    report: Report,
    verbose_result: IntegrityVerboseResult | None,
    *,
    quiet: bool = False,
) -> None:
    """integrity 검사 결과 출력.

    quiet=False (기본): 검사 대상 + 항목별 결과 verbose 출력.
    quiet=True: 기존 요약만 출력 (CI 친화).
    """
    if quiet or verbose_result is None:
        # quiet 모드: 이슈 목록 + 요약만
        for issue in report.issues:
            tag = "[ERROR]" if issue.severity == "error" else "[WARN] "
            print(f"{tag} [{issue.file}] {issue.message}")
        print()
        print(f"Files checked: {report.files_checked}  Errors: {report.error_count}  Warnings: {report.warn_count}")
        if report.error_count == 0:
            print(f"[OK] Schema validation passed{' (' + str(report.warn_count) + ' advisory WARN)' if report.warn_count else ''}")
        else:
            print("[FAIL] Validation failed — fix errors above")
        return

    # verbose 모드
    vr = verbose_result
    print(f"[integrity] project: {vr.project}")

    if not vr.skeleton_exists:
        print("[integrity] skeleton.md: 아직 생성 안 됨 (skip) — /ha-design 후 다시 실행")
    else:
        assert vr.skeleton_path is not None
        print(f"[integrity] {vr.skeleton_path.name}: 검사 대상")

        # filesystem 블록 검사 결과
        if vr.filesystem_blocks == 0:
            print("  ✓ ```filesystem 블록 없음 — 경로 검사 skip (opt-in)")
        else:
            fs_ok = vr.filesystem_paths_ok
            fs_total = vr.filesystem_paths_declared
            fs_missing = fs_total - fs_ok
            if fs_missing == 0:
                print(f"  ✓ filesystem 블록 선언 경로 모두 실재 ({fs_ok}/{fs_total})")
            else:
                print(f"  ✗ filesystem 블록: {fs_missing}개 경로 미존재 ({fs_ok}/{fs_total})")

        # placeholder 검사 결과
        if vr.placeholder_count == 0:
            print("  ✓ 미치환 placeholder 0건")
        else:
            print(f"  ✗ 미치환 placeholder {vr.placeholder_count}건 — /ha-design 에서 기입 필요")

    # file_structure drift 결과
    if vr.drift_checks:
        for profile_id, extras, missing in vr.drift_checks:
            print(f"[integrity] profile {profile_id} file_structure drift:")
            if not extras and not missing:
                print("  ✓ 선언 디렉토리 일치")
            else:
                if extras:
                    extras_short = ", ".join(extras[:5])
                    more = f" … +{len(extras) - 5}개" if len(extras) > 5 else ""
                    print(f"  [WARN] extras: {extras_short}{more} (의도 확장?)")
                if missing:
                    missing_short = ", ".join(missing[:5])
                    print(f"  [WARN] missing: {missing_short}")
    else:
        print("[integrity] file_structure drift: 검사 대상 profile 없음 (skip)")

    print("---")
    warn_note = f" ({report.warn_count} advisory WARN)" if report.warn_count else ""
    print(f"Files checked: {report.files_checked}  Errors: {report.error_count}  Warnings: {report.warn_count}")
    if report.error_count == 0:
        print(f"[OK] Schema validation passed{warn_note}")
    else:
        print("[FAIL] Validation failed — fix errors above")


def _resolve_harness_ai_home() -> Path | None:
    """Resolve the HarnessAI repo root (contains backend/ + skills/).

    Priority: HARNESS_AI_HOME env → HARNESS_ROOT.parent (repo layout).
    Returns None when neither yields a directory containing backend/.
    """
    env = os.environ.get("HARNESS_AI_HOME")
    if env:
        home = Path(env).expanduser().resolve()
        return home if (home / "backend").is_dir() else None
    candidate = HARNESS_ROOT.parent
    return candidate if (candidate / "backend").is_dir() else None


def _load_agent_scaffold(home: Path):  # type: ignore[no-untyped-def]
    """Load agent_scaffold.py standalone (no orchestrator package __init__).

    The module imports only stdlib, so a direct file load avoids pulling in
    the heavy orchestration engine (pydantic/yaml) that scaffolding never needs.
    """
    import importlib.util  # noqa: PLC0415

    mod_path = home / "backend" / "src" / "orchestrator" / "agent_scaffold.py"
    if not mod_path.is_file():
        raise FileNotFoundError(f"agent_scaffold.py not found at {mod_path}")
    spec = importlib.util.spec_from_file_location("ha_agent_scaffold", mod_path)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load agent_scaffold from {mod_path}")
    module = importlib.util.module_from_spec(spec)
    # Register before exec: @dataclass forward-ref resolution looks the module
    # up in sys.modules via cls.__module__.
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def cmd_scaffold(agent: str, skill: str | None, out_dir: Path, dry_run: bool) -> int:
    """Generate per-agent command files from neutral SKILL.md sources."""
    home = _resolve_harness_ai_home()
    if home is None:
        print(
            "[FAIL] HARNESS_AI_HOME 환경변수 필요 — HarnessAI 레포 절대 경로를 가리켜야 함.\n"
            "  예: $env:HARNESS_AI_HOME = 'C:\\path\\to\\harnessai'  (PowerShell)",
            file=sys.stderr,
        )
        return 3

    try:
        scaffold = _load_agent_scaffold(home)
    except (FileNotFoundError, ImportError) as e:
        print(f"[FAIL] {e}", file=sys.stderr)
        return 3

    known = set(scaffold.AGENT_SPECS)
    agents = sorted(known) if agent == "all" else [agent]
    for a in agents:
        if a not in known:
            print(
                f"[FAIL] unknown agent {a!r} — must be one of {sorted(known)} or 'all'",
                file=sys.stderr,
            )
            return 2

    skills_root = home / "skills"
    if skill:
        skill_dirs = [skills_root / skill]
        if not (skill_dirs[0] / "SKILL.md").is_file():
            print(f"[FAIL] SKILL.md 없음: {skill_dirs[0] / 'SKILL.md'}", file=sys.stderr)
            return 3
    else:
        skill_dirs = sorted(
            d for d in skills_root.glob("ha-*") if (d / "SKILL.md").is_file()
        )
        if not skill_dirs:
            print(f"[FAIL] ha-* 스킬 없음: {skills_root}", file=sys.stderr)
            return 3

    written = 0
    skipped = 0
    for a in agents:
        for sdir in skill_dirs:
            name = sdir.name
            text = (sdir / "SKILL.md").read_text(encoding="utf-8")
            desc, body = scaffold.parse_skill_md(text)
            try:
                rel, content = scaffold.render(name, desc, body, a)
            except ValueError as e:
                print(f"  [SKIP] {a}/{name}: {e}")
                skipped += 1
                continue
            written += _write_scaffold_file(out_dir / rel, content, rel, dry_run)
        if a != "claude":
            crel, ccontent = scaffold.render_context(a)
            written += _write_scaffold_file(out_dir / crel, ccontent, crel, dry_run)

    verb = "would write" if dry_run else "wrote"
    extra = f", {skipped} skipped" if skipped else ""
    print(f"---\n[OK] {verb} {written} file(s){extra} → {out_dir}")
    return 0


def _write_scaffold_file(path: Path, content: str, rel: str, dry_run: bool) -> int:
    """Write one scaffold file (or print in dry-run). Returns 1 if written."""
    if dry_run:
        print(f"  [DRY] {rel}")
        return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    print(f"  [WRITE] {rel}")
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(prog="harness")
    sub = parser.add_subparsers(dest="cmd", required=True)

    v = sub.add_parser("validate", help="스키마 검증")
    v.add_argument("target", nargs="?", help="검증 대상: all|profiles|fragments|registry|<path>")
    v.add_argument("--plan", type=Path, help="harness-plan.md 경로")

    i = sub.add_parser("integrity", help="skeleton.md ↔ 실재 파일시스템 정합성 검사")
    i.add_argument("--project", type=Path, default=Path.cwd(), help="프로젝트 루트 (default: cwd)")
    i.add_argument("--plan", type=Path, default=None, help="harness-plan.md 경로 (자동 탐색)")
    i.add_argument("--quiet", action="store_true", default=False, help="요약만 출력 (CI 친화)")

    msh = sub.add_parser(
        "migrate-skeleton-hash",
        help="legacy plan (skeleton_hash 없음) 에 skeleton.md SHA-256 hash 백필",
    )
    msh.add_argument("plan_path", type=Path, help="harness-plan.md 경로")
    msh.add_argument(
        "--apply",
        action="store_true",
        default=False,
        help="실제 plan 파일 갱신 + 자동 백업 (기본: dry-run)",
    )
    msh.add_argument(
        "--no-backup",
        action="store_true",
        default=False,
        dest="no_backup",
        help="--apply 시 백업 생성 생략 (위험)",
    )

    af = sub.add_parser(
        "analyze-failure",
        help="빌드/테스트 출력에서 실패 파일 추출 + tasks.md 태스크 매핑 (JSON 출력)",
    )
    af.add_argument(
        "output_file",
        help="분석할 출력 파일 경로 (- 면 stdin)",
    )
    af.add_argument(
        "--tasks",
        default="docs/tasks.md",
        help="tasks.md 경로 (기본: <cwd>/docs/tasks.md)",
    )

    g = sub.add_parser(
        "graph",
        help="tasks.md → mermaid 의존성 그래프 (stdout 또는 --inject)",
    )
    g.add_argument("tasks_path", type=Path, help="tasks.md 경로")
    g.add_argument(
        "--inject",
        action="store_true",
        default=False,
        help="섹션을 tasks.md 끝에 추가 (자동 백업 + 멱등)",
    )
    g.add_argument(
        "--no-phases",
        action="store_true",
        default=False,
        dest="no_phases",
        help="Phase subgraph 그룹 생략 (평면 노드 리스트)",
    )

    sc = sub.add_parser(
        "scaffold",
        help="중립 SKILL.md → 에이전트별 명령 파일 생성 (claude/gemini/copilot)",
    )
    sc.add_argument(
        "--agent",
        required=True,
        help="대상 에이전트: claude|gemini|copilot|all",
    )
    sc.add_argument(
        "--skill",
        default=None,
        help="단일 스킬명 (예: ha-verify). 생략 시 모든 ha-* 스킬",
    )
    sc.add_argument(
        "--out",
        type=Path,
        default=Path.cwd(),
        help="출력 프로젝트 루트 (default: cwd)",
    )
    sc.add_argument(
        "--dry-run",
        action="store_true",
        default=False,
        dest="dry_run",
        help="파일 쓰지 않고 생성될 경로만 출력",
    )

    mv10 = sub.add_parser(
        "migrate-v10",
        help="v0.9.x → v0.10.0 마이그레이션 (frozen_status 필드 추가)",
    )
    mv10.add_argument("project", type=Path, help="프로젝트 루트 경로 (docs/harness-plan.md 위치)")
    mv10.add_argument(
        "--auto-freeze",
        action="store_true",
        default=False,
        dest="auto_freeze",
        help="included LOCKED 후보 섹션 즉시 freeze (사용자 책임 — 가짜 frozen 위험)",
    )
    mv10.add_argument(
        "--dry-run",
        action="store_true",
        default=False,
        dest="dry_run",
        help="변경 안 하고 미리보기",
    )

    args = parser.parse_args()

    if args.cmd == "integrity":
        report = Report()
        vr = check_integrity_verbose(args.project.resolve(), args.plan, report)
        print_integrity_report(report, vr, quiet=args.quiet)
        return 0 if report.error_count == 0 else 1

    if args.cmd == "analyze-failure":
        return _cmd_analyze_failure(args)

    if args.cmd == "migrate-skeleton-hash":
        return cmd_migrate_skeleton_hash(
            plan_path=args.plan_path.expanduser().resolve(),
            apply=args.apply,
            no_backup=args.no_backup,
        )

    if args.cmd == "graph":
        return cmd_graph(
            tasks_path=args.tasks_path.expanduser().resolve(),
            inject=args.inject,
            no_phases=args.no_phases,
        )

    if args.cmd == "scaffold":
        return cmd_scaffold(
            agent=args.agent,
            skill=args.skill,
            out_dir=args.out.expanduser().resolve(),
            dry_run=args.dry_run,
        )

    if args.cmd == "migrate-v10":
        _bin_dir = Path(__file__).resolve().parent
        if str(_bin_dir) not in sys.path:
            sys.path.insert(0, str(_bin_dir))
        from migrate_v10 import migrate  # noqa: PLC0415
        return migrate(
            args.project.expanduser().resolve(),
            auto_freeze=args.auto_freeze,
            dry_run=args.dry_run,
        )

    if args.cmd != "validate":
        parser.print_help()
        return 2

    report = Report()

    if args.plan:
        validate_plan(args.plan, report)
    elif args.target is None or args.target == "all":
        validate_all(report)
    elif args.target == "profiles":
        profiles_dir = HARNESS_ROOT / "profiles"
        registry = profiles_dir / "_registry.yaml"
        if registry.exists():
            validate_registry(registry, report)
        for f in sorted(profiles_dir.glob("*.md")):
            if f.name == "_base.md":
                validate_base_md(f, report)
            else:
                validate_profile(f, report)
        detect_inheritance_cycles(profiles_dir, report)
    elif args.target == "fragments":
        fragments_dir = HARNESS_ROOT / "templates" / "skeleton"
        for f in sorted(fragments_dir.glob("*.md")):
            validate_fragment(f, report)
    elif args.target == "registry":
        validate_registry(HARNESS_ROOT / "profiles" / "_registry.yaml", report)
    else:
        validate_single(Path(args.target).expanduser().resolve(), report)

    print_report(report)
    return 0 if report.error_count == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
